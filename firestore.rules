rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /owners/{ownerUid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
    }

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == '1987zinwaimin@gmail.com';
    }

    function isAnon() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staffAccess/users/$(request.auth.uid)).data;
    }

    function activeStaff() {
      return isAnon() && exists(/databases/$(database)/documents/staffAccess/users/$(request.auth.uid))
        && staffDoc().active == true;
    }

    match /staffAccess/state {
      allow read: if isOwner() || activeStaff();
      allow create, update, delete: if isOwner() || (
        activeStaff() &&
        (
          staffDoc().get('permissions', {}).get('sellTickets', false) == true ||
          staffDoc().get('permissions', {}).get('editQuantity', false) == true ||
          staffDoc().get('permissions', {}).get('editTickets', false) == true ||
          staffDoc().get('permissions', {}).get('editEvents', false) == true
        )
      );
    }

    match /staffAccess/users/{staffUid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == staffUid);
      allow create: if isAnon()
        && request.auth.uid == staffUid
        && request.resource.data.name is string
        && request.resource.data.role in ['sale','entry','customer','event']
        && request.resource.data.active == false;
      allow update, delete: if isOwner();
    }
  }
}