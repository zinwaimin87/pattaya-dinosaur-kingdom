rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Owner-only private data.
    match /owners/{ownerUid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
    }

    function isOwner() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == '1987zinwaimin@gmail.com';
    }

    function isAnon() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staffAccessUsers/$(request.auth.uid)).data;
    }

    // Staff can enter immediately after entering their name + role.
    // Only an explicit Owner disable blocks the account.
    function activeStaff() {
      return isAnon()
        && exists(/databases/$(database)/documents/staffAccessUsers/$(request.auth.uid))
        && staffDoc().get('disabledByOwner', false) != true;
    }

    match /staffAccess/state {
      allow read: if isOwner() || activeStaff();

      allow create, update, delete: if isOwner() || (
        activeStaff() &&
        (
          staffDoc().get('permissions', {}).get('sellTickets', false) == true ||
          staffDoc().get('permissions', {}).get('editQuantity', false) == true ||
          staffDoc().get('permissions', {}).get('editTickets', false) == true ||
          staffDoc().get('permissions', {}).get('editEvents', false) == true
        )
      );
    }

    match /staffAccessUsers/{staffUid} {
      // Owner can see and manage every staff account; a staff member can read only itself.
      allow read: if isOwner() || (request.auth != null && request.auth.uid == staffUid);

      // Staff account is active immediately. No Owner approval is required.
      allow create: if isAnon()
        && request.auth.uid == staffUid
        && request.resource.data.name is string
        && request.resource.data.role in ['sale','entry','customer','event']
        && request.resource.data.active == true
        && request.resource.data.get('disabledByOwner', false) == false;

      // Staff may update only login metadata and cannot change role, permissions,
      // or Owner disable state. Owner controls active/disabled state.
      allow update: if isOwner() || (
        isAnon()
        && request.auth.uid == staffUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'active',
          'lastLoginAt',
          'lastLoginDevice'
        ])
        && request.resource.data.get('disabledByOwner', false) == false
        && request.resource.data.active == true
      );

      allow delete: if isOwner();
    }

    // Everything else is private/denied to clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}